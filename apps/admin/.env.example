# [RUNTIME] Public URL of the main domain (used for absolute middleware redirects and CSRF verification)
PUBLIC_SITE_URL=http://localhost:3000

# [RUNTIME] Backend REST API base URL
BACKEND_URL=http://localhost:8000

# [BUILD-TIME] Inlined public site URL for client components
NEXT_PUBLIC_SITE_URL=http://localhost:3000
