# ==============================================================================
# STOREFRONT (apps/web) ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# [RUNTIME] Public URL of the storefront (used for canonicals, OG tags, sitemap)
PUBLIC_SITE_URL=http://localhost:3000

# [RUNTIME] Backend REST API base URL
BACKEND_URL=http://localhost:8000

# [RUNTIME / DEV ONLY] Admin local URL for multi-zone rewrites (leave blank in production)
ADMIN_URL=http://localhost:3001

# [RUNTIME] Shared secret for on-demand ISR revalidation via POST /api/revalidate
REVALIDATE_SECRET=your_revalidate_secret_key_here

# [BUILD-TIME] Inlined public site URL for client components
NEXT_PUBLIC_SITE_URL=http://localhost:3000
