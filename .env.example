# ==============================================================================
# MOTORCYCLE E-COMMERCE WORKSPACE (MONOREPO) ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# IMPORTANT: Missing required environment variables will cause build and boot failure!
# Copy these values into your server deployment environment (e.g. PM2 ecosystem,
# /etc/store/web.env, or GitLab CI/CD variables).

# ------------------------------------------------------------------------------
# Storefront Web Application (apps/web)
# ------------------------------------------------------------------------------
# [REQUIRED] Public URL of the storefront (used for canonical URLs, OG tags, robots.txt, sitemap)
PUBLIC_SITE_URL=https://yourdomain.com

# [REQUIRED] Backend REST API base URL (production API endpoint)
BACKEND_URL=https://api.yourdomain.com

# [OPTIONAL] Admin portal URL for multi-zone reverse proxy rewrites (omit if reverse proxied via Nginx)
ADMIN_URL=https://yourdomain.com/admin

# [REQUIRED] Shared secret token for ISR revalidation API calls (POST /api/revalidate)
REVALIDATE_SECRET=generate_a_secure_random_token_here

# [REQUIRED] Public site URL exposed to client components (must match PUBLIC_SITE_URL)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# Admin Portal Application (apps/admin)
# ------------------------------------------------------------------------------
# [REQUIRED] Node Environment
NODE_ENV=production
PORT=3001
