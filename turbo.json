{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SITE_URL",
    "BACKEND_URL",
    "ADMIN_URL",
    "REVALIDATE_SECRET",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
